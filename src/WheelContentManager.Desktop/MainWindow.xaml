<Window x:Class="WheelContentManager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WheelContentManager.Desktop" xmlns:core="clr-namespace:WheelContentManager.Core;assembly=WheelContentManager.Core" Title="WT - Blog Generator 0.7.2" Width="1380" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Window.Resources><Style x:Key="GalleryText" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding PromptUsed}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="#64748B"/></DataTrigger></Style.Triggers></Style><local:InverseBooleanConverter x:Key="Not"/><local:BrandConverter x:Key="Brand"/></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Left"><TextBlock Text="WT - Blog Generator" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Galeria → plik z poleceniem i danymi → ChatGPT" Foreground="#64748B" FontSize="14" Margin="0,6,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding Busy, Converter={StaticResource Not}}"><Button Content="Poczta / harmonogram" Command="{Binding ConfigureMailCommand}" Background="#E8EDF6" Foreground="#14213B"/><Button Content="JR Wheels" Command="{Binding ChooseBrandCommand}" CommandParameter="{x:Static core:WheelBrand.JR}"/><Button Content="Concaver Wheels" Command="{Binding ChooseBrandCommand}" CommandParameter="{x:Static core:WheelBrand.Concaver}"/><Button Content="Vesser Forged" Command="{Binding ChooseBrandCommand}" CommandParameter="{x:Static core:WheelBrand.Vesser}"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1"><Border Style="{StaticResource Card}" Padding="16"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Wznów przygotowanie w tle" Command="{Binding ResumeBackgroundCommand}" Background="#E8EDF6" Foreground="#14213B"/><TextBlock Text="{Binding WeeklyBatchLabel}" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding WeeklyStatus}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,8"/><ItemsControl ItemsSource="{Binding WeeklyItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Brand, Converter={StaticResource Brand}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Model}" Foreground="#64748B"/><WrapPanel><Button Content="Otwórz paczkę" Command="{Binding DataContext.OpenWeeklyPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Package.Folder}" Padding="10,7"/><Button Content="Galeria ↗" Command="{Binding DataContext.OpenWeeklyGalleryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Package.GalleryUrl}" Padding="10,7" Background="#E8EDF6" Foreground="#14213B"/></WrapPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="Sprawdź /blog i odśwież listę" Command="{Binding RefreshCommand}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/><StackPanel><TextBlock Text="{Binding BrandTitle}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Galerie bez wykrytego wpisu na /blog. Przekreślone, wykorzystane galerie są na końcu listy." Foreground="#64748B" Margin="0,6,0,4"/><TextBlock Text="{Binding LastChecked}" Foreground="#64748B" FontSize="12"/></StackPanel></DockPanel></Border></StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Wyszukaj samochód lub model felg" FontSize="15" Padding="12"/><TextBlock Grid.Row="1" Text="{Binding CountLabel}" Margin="0,10,0,14" Foreground="#64748B"/><DataGrid CanUserSortColumns="False" Grid.Row="2" IsEnabled="{Binding Busy, Converter={StaticResource Not}}" ItemsSource="{Binding GalleryView}" SelectedItem="{Binding SelectedGallery}" FontSize="14" RowHeight="64"><DataGrid.Columns><DataGridTemplateColumn Header="Zdjęcie" Width="88"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding ThumbnailUrl}" Width="74" Height="48" Stretch="UniformToFill"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource GalleryText}" Header="Samochód" Binding="{Binding Vehicle.Display}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GalleryText}" Header="Felgi" Binding="{Binding Specification.Model}" Width="95"/></DataGrid.Columns></DataGrid></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock FontSize="14" Margin="0,0,0,12" TextWrapping="Wrap"><Hyperlink Command="{Binding OpenGalleryCommand}"><Run Text="Galeria źródłowa ↗ — "/><Run Text="{Binding SelectedGallery.ExternalId, Mode=OneWay}"/></Hyperlink></TextBlock><TextBlock Text="{Binding SelectedGallery.Vehicle.Display}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedGallery.Specification.Model}" FontSize="17" Foreground="#2563EB" Margin="0,6,0,14"/><Image Source="{Binding SelectedGallery.ThumbnailUrl}" Height="200" Stretch="Uniform" Margin="0,0,0,14"/><Button Content="Otwórz galerię zdjęć ↗" Command="{Binding OpenGalleryCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding SelectedGallery.Url}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,0,0,12"/><WrapPanel><Button Content="Karta felg ↗" Command="{Binding OpenProductCommand}" Background="#E8EDF6" Foreground="#14213B"/><Button Content="Otwórz zdjęcie ↗" Command="{Binding OpenPhotoCommand}" Background="#E8EDF6" Foreground="#14213B"/></WrapPanel><Button Content="{Binding UsageButtonLabel}" Command="{Binding ToggleUsageCommand}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}" Background="#E8EDF6" Foreground="#14213B" Margin="0,10,0,0"/><Separator Margin="0,16"/><TextBlock Text="Plik gotowy do wrzucenia do ChatGPT" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Zawiera polecenie, dane auta, pełne wymagania EN → PL, źródła i klikalne linki. Po zapisaniu galeria będzie oznaczona jako wykorzystana; oznaczenie możesz cofnąć. Zdjęcie JPG/PNG będzie w dokumencie i osobno w folderze, jeśli uda się je pobrać." TextWrapping="Wrap" Foreground="#64748B" Margin="0,10,0,14"/><TextBlock Text="Folder zapisu" FontWeight="SemiBold"/><TextBox Text="{Binding OutputFolder}" IsReadOnly="True"/><Button Content="Wybierz folder" Command="{Binding ChooseFolderCommand}" HorizontalAlignment="Left" Background="#E8EDF6" Foreground="#14213B"/><Button Content="Przygotuj plik do ChatGPT" Command="{Binding PrepareFileCommand}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}" FontSize="16" Padding="18,14" Margin="0,12,0,8"/><Button Content="Otwórz zapisany folder" Command="{Binding OpenFolderCommand}" Background="#E8EDF6" Foreground="#14213B"/><TextBlock Text="Przed zapisaniem program pobierze galerię, kartę felg i aktualną listę wpisów. Treści istniejących wpisów pamięta do 15 minut; odświeżenie listy wymusza pełny skan. Wrzuć DOCX do ChatGPT — instrukcja wykonania jest w dokumencie. Zdjęcie WebP dołącz osobno, jeśli występuje." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12,0,0"/><Expander Header="Podgląd polecenia" Margin="0,14"><TextBox Text="{Binding Prompt, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="240" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="3" BorderBrush="#DEE5EF" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Anuluj" Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0"/></StackPanel></Border>
 </Grid>
</Window>
