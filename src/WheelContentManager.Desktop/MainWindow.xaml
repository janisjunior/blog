<Window x:Class="WheelContentManager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WheelContentManager.Desktop" Title="Wheel Content Manager 0.2.0" Width="1400" Height="920" MinWidth="1060" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Window.Resources><local:InverseBooleanConverter x:Key="Not"/><local:StatusConverter x:Key="StatusLabel"/><local:BrandConverter x:Key="BrandLabel"/><local:NotificationStateConverter x:Key="NotificationState"/><local:SourceFieldConverter x:Key="SourceField"/><local:LanguagesConverter x:Key="Languages"/></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#122039"><Grid Margin="22,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="WHEEL" FontSize="29" FontWeight="Bold" Foreground="White"/><TextBlock Text="CONTENT MANAGER" FontSize="11" Foreground="#8DA4CA" Margin="2,4,0,40"/><TextBlock Text="PRZESTRZEŃ ROBOCZA" Foreground="#8DA4CA" FontSize="10" Margin="0,0,0,18"/></StackPanel>
   <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Foreground="White"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="item" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#2563EB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="item" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
   <StackPanel Grid.Row="2"><TextBlock Text="WHEELTRADE" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Treści PL + EN · bez publikacji" Foreground="#8DA4CA" FontSize="11" Margin="0,6,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="30,26,20,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" IsEnabled="{Binding Busy, Converter={StaticResource Not}}">
    <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Height" Value="0"/><Setter Property="Width" Value="0"/><Setter Property="Padding" Value="0"/></Style></TabControl.ItemContainerStyle>
    <TabItem Header="Pulpit"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Twoje centrum treści" Style="{StaticResource Heading}"/><TextBlock Text="Od prawdziwej galerii do artykułu gotowego do akceptacji." Foreground="#64748B" Margin="0,0,0,26"/>
     <UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Galerie w bazie" Foreground="#64748B"/><TextBlock Text="{Binding GalleryCount}" FontSize="38" FontWeight="SemiBold" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gotowe i zatwierdzone" Foreground="#64748B"/><TextBlock Text="{Binding ReadyCount}" FontSize="38" FontWeight="SemiBold" Foreground="#059669" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Wymagają poprawy" Foreground="#64748B"/><TextBlock Text="{Binding CorrectionCount}" FontSize="38" FontWeight="SemiBold" Foreground="#D97706" Margin="0,8"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Przygotuj kolejny cykl" Style="{StaticResource Subheading}"/><WrapPanel><Button Content="Sprawdź galerie" Command="{Binding SyncCommand}"/><Button Content="Zaproponuj tematy" Command="{Binding SuggestTopicsCommand}"/><Button Content="Generuj cykl 3 marek" Command="{Binding GenerateCycleCommand}"/><Button Content="Otwórz artykuły" Command="{Binding OpenArticlesCommand}" Background="#E8EDF6" Foreground="#14213B"/><Button Content="Ustawienia" Command="{Binding OpenSettingsCommand}" Background="#E8EDF6" Foreground="#14213B"/></WrapPanel><TextBlock Text="Ostatnia synchronizacja" FontWeight="SemiBold" Margin="0,18,0,6"/><TextBlock Text="{Binding LastSync}" TextWrapping="Wrap" Foreground="#64748B"/><TextBlock Text="Następny zaplanowany cykl" FontWeight="SemiBold" Margin="0,18,0,6"/><TextBlock Text="{Binding NextRun}" Foreground="#64748B"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Co warto napisać teraz" Style="{StaticResource Subheading}"/><TextBlock Text="Dobór preferuje inne modele niż w ostatnich publikacjach każdej marki. Zdjęcia są analizowane przez AI; domyślnie eksport zawiera tylko teksty." TextWrapping="Wrap" Margin="0,0,0,12"/><DataGrid ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" MaxHeight="300"><DataGrid.Columns><DataGridTextColumn Header="Galeria" Binding="{Binding Gallery.Display}" Width="*"/><DataGridTextColumn Header="Dlaczego teraz" Binding="{Binding Reason}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><Button Content="Otwórz wybraną galerię" Command="{Binding OpenSuggestedGalleryCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ostatnie artykuły" Style="{StaticResource Subheading}"/><DataGrid ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle}" MaxHeight="260"><DataGrid.Columns><DataGridTextColumn Header="Samochód" Binding="{Binding Gallery.Vehicle.Display}" Width="*"/><DataGridTextColumn Header="Felgi" Binding="{Binding Gallery.Specification.Model}" Width="150"/><DataGridTextColumn Header="Stan" Binding="{Binding Status, Converter={StaticResource StatusLabel}}" Width="190"/></DataGrid.Columns></DataGrid></StackPanel></Border>
     <TextBlock Text="{Binding Report}" TextWrapping="Wrap" Margin="0,0,0,20"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Galerie"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Galerie samochodów" Style="{StaticResource Heading}"/><TextBlock Text="Prawdziwe konfiguracje. Dane nieznane pozostają niepotwierdzone." Foreground="#64748B" Margin="0,0,0,16"/></StackPanel>
     <WrapPanel Grid.Row="1"><ComboBox ItemsSource="{Binding BrandFilters}" SelectedItem="{Binding BrandFilter}" Width="170" Margin="0,4,10,12"/><ComboBox ItemsSource="{Binding UsageFilters}" SelectedItem="{Binding UsageFilter}" Width="160" Margin="0,4,10,12"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="250" ToolTip="Wyszukaj producenta, samochód lub model felg" Margin="0,4,10,12"/><ComboBox ItemsSource="{Binding CarMakes}" SelectedItem="{Binding CarMakeFilter}" Width="170" Margin="0,4,10,12"/><TextBox Text="{Binding CarModelFilter, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Filtr modelu samochodu" Margin="0,4,10,12"/><TextBox Text="{Binding WheelModelFilter, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Filtr modelu felg" Margin="0,4,10,12"/><DatePicker SelectedDate="{Binding AddedAfter}" ToolTip="Galerie dodane od daty" Margin="0,4,10,12"/><Button Content="Odśwież" Command="{Binding RefreshCommand}"/></WrapPanel>
     <DataGrid Grid.Row="2" ItemsSource="{Binding GalleryView}" SelectedItem="{Binding SelectedGallery}" Margin="0,0,0,16"><DataGrid.Columns><DataGridTemplateColumn Header="Zdjęcie" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding ThumbnailUrl}" Width="78" Height="42" Stretch="UniformToFill"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Marka felg" Binding="{Binding Brand, Converter={StaticResource BrandLabel}}" Width="145"/><DataGridTextColumn Header="Samochód" Binding="{Binding Vehicle.Display}" Width="*"/><DataGridTextColumn Header="Felgi" Binding="{Binding Specification.Model}" Width="130"/><DataGridCheckBoxColumn Header="Wykorzystana" Binding="{Binding Used}" Width="100"/><DataGridTextColumn Header="Sprawdzenie /blog" Binding="{Binding BlogStatus}" Width="210"/><DataGridTextColumn Header="Braki" Binding="{Binding MissingData}" Width="180"/></DataGrid.Columns></DataGrid>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Szczegóły i korekta galerii" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding SelectedGallery.BlogStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedGallery.ExistingBlogUrl}" TextWrapping="Wrap" Foreground="#2563EB"/><TextBlock Text="{Binding SelectedGallery.Url}" TextWrapping="Wrap" Foreground="#64748B"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,16"><ItemsControl ItemsSource="{Binding SelectedGallery.Images}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,12,0"><Image Source="{Binding Url}" Width="260" Height="170" Stretch="UniformToFill"/><CheckBox Content="Mam prawo do użycia w eksporcie" Visibility="{Binding DataContext.Settings.ExportImages, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" IsChecked="{Binding UsageAllowed}" Margin="0,8"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <UniformGrid Columns="4"><StackPanel Margin="0,0,12,0"><TextBlock Text="Producent samochodu"/><TextBox Text="{Binding SelectedGallery.Vehicle.Make}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Model samochodu"/><TextBox Text="{Binding SelectedGallery.Vehicle.Model}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Wersja"/><TextBox Text="{Binding SelectedGallery.Vehicle.Version}"/></StackPanel><StackPanel><TextBlock Text="Model felg"/><TextBox Text="{Binding SelectedGallery.Specification.Model}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Wykończenie"/><TextBox Text="{Binding SelectedGallery.Specification.Finish}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Rozmiar — przód"/><TextBox Text="{Binding SelectedGallery.Specification.FrontSize}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Rozmiar — tył"/><TextBox Text="{Binding SelectedGallery.Specification.RearSize}"/></StackPanel><StackPanel><TextBlock Text="ET / offset"/><TextBox Text="{Binding SelectedGallery.Specification.Et}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="PCD"/><TextBox Text="{Binding SelectedGallery.Specification.Pcd}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Dostępne rozmiary"/><TextBox Text="{Binding SelectedGallery.Specification.AvailableSizes}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Potwierdzone certyfikaty"/><TextBox Text="{Binding SelectedGallery.Specification.Certifications}"/></StackPanel><StackPanel><TextBlock Text="Dane produktowe"/><TextBox Text="{Binding SelectedGallery.Specification.ProductDetails}"/></StackPanel></UniformGrid>
      <CheckBox Content="Sprawdziłem wpisane parametry w źródle galerii / produktu" IsChecked="{Binding GalleryConfirmed}" Margin="0,8,0,18"/><WrapPanel><Button Content="Otwórz galerię źródłową" Command="{Binding OpenGallerySourceCommand}" Background="#64748B"/><Button Content="Karta produktu" Command="{Binding OpenProductSourceCommand}" Background="#64748B"/><Button Content="Pobierz szczegóły i zdjęcia" Command="{Binding LoadGalleryCommand}"/><Button Content="Zapisz korektę" Command="{Binding SaveGalleryCommand}"/><Button Content="Generuj artykuł PL + EN" Command="{Binding GenerateSelectedCommand}"/><Button Content="Generuj ponownie" Command="{Binding RegenerateGalleryCommand}" Background="#64748B"/><Button Content="Test AI bez wykorzystania galerii" Command="{Binding TestPromptCommand}" Background="#64748B"/></WrapPanel>
      <Expander Header="Źródła parametrów"><DataGrid ItemsSource="{Binding SelectedGallery.Sources}" MaxHeight="230"><DataGrid.Columns><DataGridTextColumn Header="Parametr" Binding="{Binding Field, Converter={StaticResource SourceField}}" Width="130"/><DataGridTextColumn Header="Wartość" Binding="{Binding Value}" Width="180"/><DataGridCheckBoxColumn Header="Potwierdzony" Binding="{Binding Confirmed}" Width="100"/><DataGridTextColumn Header="URL źródła" Binding="{Binding Url}" Width="*"/></DataGrid.Columns></DataGrid></Expander><TextBlock Text="Analiza wizualna" FontWeight="SemiBold" Margin="0,12"/><TextBox Text="{Binding SelectedGallery.VisualAnalysis, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
     </StackPanel></Border></ScrollViewer>
    </Grid></TabItem>
    <TabItem Header="Artykuły"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="4*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Artykuły" Style="{StaticResource Heading}"/><TextBox Text="{Binding ArticleSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Wyszukaj artykuł" Width="350" HorizontalAlignment="Left"/></StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding ArticleView}" SelectedItem="{Binding SelectedArticle}" Margin="0,0,0,16"><DataGrid.Columns><DataGridTextColumn Header="Marka" Binding="{Binding Gallery.Brand, Converter={StaticResource BrandLabel}}" Width="140"/><DataGridTextColumn Header="Samochód" Binding="{Binding Gallery.Vehicle.Display}" Width="*"/><DataGridTextColumn Header="Felgi" Binding="{Binding Gallery.Specification.Model}" Width="120"/><DataGridTextColumn Header="Języki" Binding="{Binding Versions, Converter={StaticResource Languages}}" Width="75"/><DataGridTextColumn Header="Utworzono" Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/><DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource StatusLabel}}" Width="180"/></DataGrid.Columns></DataGrid>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding SelectedArticleStatus}" Style="{StaticResource Subheading}"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="90" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding SelectedArticle.Gallery.Display}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
      <ItemsControl ItemsSource="{Binding SelectedArticle.Gallery.Images}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Url}" Width="220" Height="140" Stretch="UniformToFill" Margin="0,0,12,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Tytuł"/><TextBox Text="{Binding ArticleTitle, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Intro (maksymalnie 200 znaków)"/><TextBox Text="{Binding ArticleIntro, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/><TextBlock Text="Treść"/><TextBox Text="{Binding ArticleBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260" MaxHeight="460" VerticalScrollBarVisibility="Auto"/>
      <TextBlock Text="{Binding ArticleWarnings}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <WrapPanel><Button Content="Zapisz nową wersję" Command="{Binding SaveArticleCommand}"/><Button Content="Kopiuj tekst" Command="{Binding CopyArticleCommand}"/><Button Content="Eksportuj wybrany język" Command="{Binding ExportLanguageCommand}"/><Button Content="Eksportuj PL + EN i zdjęcia" Command="{Binding ExportAllCommand}"/><Button Content="Wygeneruj język ponownie" Command="{Binding RegenerateLanguageCommand}" Background="#64748B"/><Button Content="Zatwierdź" Command="{Binding ApproveCommand}" Background="#059669"/><Button Content="Oznacz jako opublikowany" Command="{Binding MarkPublishedCommand}" Background="#64748B"/></WrapPanel>
      <Expander Header="Historia edycji"><TextBlock Text="{Binding ArticleHistory}" TextWrapping="Wrap" Margin="0,12"/></Expander>
     </StackPanel></Border></ScrollViewer>
    </Grid></TabItem>
    <TabItem Header="Prompty AI"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Prompty AI" Style="{StaticResource Heading}"/><TextBlock Text="Pełne instrukcje redakcyjne, niezależne dla każdej marki. Każdy zapis tworzy nową wersję." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,20"/></StackPanel>
     <WrapPanel Grid.Row="1"><ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding PromptBrand}" Width="170"/><Button Content="Importuj Wpisy na bloga.docx" Command="{Binding ImportPromptCommand}" Margin="12,0,8,8"/><ComboBox ItemsSource="{Binding PromptHistory}" SelectedItem="{Binding SelectedPromptVersion}" DisplayMemberPath="Revision" Width="130" ToolTip="Wersja promptu do podglądu"/></WrapPanel>
     <TextBox Grid.Row="2" Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
     <StackPanel Grid.Row="3"><TextBlock Text="Po imporcie zastąp konkretne przykłady zmiennymi, np. {CAR_MODEL}, {WHEEL_MODEL}, {FRONT_SIZE}, {REAR_SIZE}. Pełna lista w README." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/><CheckBox Content="Szablon jest zgodny z pełnym dokumentem; przykłady zastąpiono zmiennymi" IsChecked="{Binding PromptVerified}" Margin="0,0,0,16"/><WrapPanel><Button Content="Zapisz wersję" Command="{Binding SavePromptCommand}"/><Button Content="Przywróć domyślną" Command="{Binding RestorePromptCommand}" Background="#64748B"/><ComboBox ItemsSource="{Binding Galleries}" SelectedItem="{Binding SelectedGallery}" DisplayMemberPath="Display" Width="350"/><Button Content="Testuj na wybranej galerii" Command="{Binding TestPromptCommand}" Background="#64748B"/></WrapPanel><TextBlock Text="Test korzysta z API (koszt), ale nie wysyła maila ani nie oznacza galerii jako wykorzystanej." TextWrapping="Wrap"/></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Harmonogram"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Automatyzacja tygodniowa" Style="{StaticResource Heading}"/><TextBlock Text="Osobny Worker przygotowuje treści także przy zamkniętym oknie aplikacji." Foreground="#64748B" Margin="0,0,0,22"/>
     <Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="Włącz automatyzację" IsChecked="{Binding Settings.ScheduleEnabled}" Margin="0,0,0,20"/><UniformGrid Columns="3"><StackPanel Margin="0,0,12,0"><TextBlock Text="Dzień tygodnia"/><ComboBox ItemsSource="{Binding Days}" SelectedIndex="{Binding ScheduleDayIndex}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Godzina (0–23)"/><TextBox Text="{Binding Settings.ScheduleHour}"/></StackPanel><StackPanel><TextBlock Text="Minuty (0–59)"/><TextBox Text="{Binding Settings.ScheduleMinute}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Artykuły na markę (1–5)"/><TextBox Text="{Binding Settings.ArticlesPerBrand}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Próby poprawy (0–3)"/><TextBox Text="{Binding Settings.MaxRetries}"/></StackPanel><StackPanel><TextBlock Text="Wybór galerii"/><ComboBox ItemsSource="{Binding SelectionModes}" SelectedItem="{Binding Settings.SelectionMode}"/></StackPanel></UniformGrid><TextBlock Text="Galerie dla trybu ręcznego (po jednej na markę)" FontWeight="SemiBold" Margin="0,8,0,12"/><ComboBox ItemsSource="{Binding JrCandidates}" SelectedValuePath="Id" DisplayMemberPath="Display" SelectedValue="{Binding Settings.ManualJrGalleryId}"/><ComboBox ItemsSource="{Binding ConcaverCandidates}" SelectedValuePath="Id" DisplayMemberPath="Display" SelectedValue="{Binding Settings.ManualConcaverGalleryId}"/><ComboBox ItemsSource="{Binding VesserCandidates}" SelectedValuePath="Id" DisplayMemberPath="Display" SelectedValue="{Binding Settings.ManualVesserGalleryId}"/><Button Content="Zastosuj w Harmonogramie Windows" Command="{Binding ApplyScheduleCommand}" HorizontalAlignment="Left"/><TextBlock Text="Komputer musi być włączony, a to konto Windows zalogowane (okno aplikacji może być zamknięte). Zadanie korzysta z sekretów tego samego konta. Pominięte uruchomienie jest wykonywane przy kolejnej dostępności. Dwa cykle nie uruchomią się równocześnie." TextWrapping="Wrap" Foreground="#64748B" Margin="0,16"/><TextBlock Text="{Binding NextRun}" FontWeight="SemiBold"/></StackPanel></Border>
     <TextBlock Text="Historia cykli" Style="{StaticResource Subheading}"/><DataGrid ItemsSource="{Binding Runs}" Height="300"><DataGrid.Columns><DataGridTextColumn Header="Rozpoczęto" Binding="{Binding Started, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/><DataGridTextColumn Header="Raport" Binding="{Binding Report}" Width="*"/></DataGrid.Columns></DataGrid>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Ustawienia"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Ustawienia" Style="{StaticResource Heading}"/><TextBlock Text="Klucze i hasła są szyfrowane przez Windows DPAPI. Puste pole zachowuje poprzedni sekret." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,22"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dostawca AI" Style="{StaticResource Subheading}"/><UniformGrid Columns="2"><StackPanel Margin="0,0,20,0"><TextBlock Text="Dostawca"/><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Settings.AiProvider}"/><TextBlock Text="Klucz API"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyChanged"/></StackPanel><StackPanel><TextBlock Text="Model z obsługą obrazów i JSON"/><ComboBox ItemsSource="{Binding Models}" Text="{Binding Settings.AiModel, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/><Button Content="Pobierz dostępne modele" Command="{Binding LoadModelsCommand}"/></StackPanel></UniformGrid><TextBlock Text="Dostęp API jest rozliczany osobno od abonamentu ChatGPT / Claude. Model może odrzucić obraz lub JSON — sprawdź go na jednej galerii." TextWrapping="Wrap" Foreground="#64748B"/>
      <TextBlock Text="Długość i kontrola kosztów" Style="{StaticResource Subheading}" Margin="0,22,0,12"/><UniformGrid Columns="3"><StackPanel Margin="0,0,14,0"><TextBlock Text="Minimum słów / język"/><TextBox Text="{Binding Settings.MinWords, Mode=OneWay}" IsReadOnly="True"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Maksimum słów / język"/><TextBox Text="{Binding Settings.MaxWords, Mode=OneWay}" IsReadOnly="True"/></StackPanel><StackPanel><TextBlock Text="Liczba zdjęć AI (1–10)"/><TextBox Text="{Binding Settings.MaxImages}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Cena input / milion tokenów (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding Settings.InputPricePerMillion}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Cena output / milion tokenów (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding Settings.OutputPricePerMillion}"/></StackPanel><StackPanel><TextBlock Text="Limit kosztu cyklu (USD)"/><TextBox Text="{Binding Settings.MaxCycleCost}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Limit tokenów cyklu"/><TextBox Text="{Binding Settings.MaxTokensPerCycle}"/></StackPanel><StackPanel><TextBlock Text="Limit wyjścia / wywołanie"/><TextBox Text="{Binding Settings.MaxOutputTokens}"/></StackPanel></UniformGrid><TextBlock Text="Wpisz aktualne stawki wybranego modelu. Kontrola używa konserwatywnej rezerwy; ostateczny koszt wynika z cennika dostawcy." TextWrapping="Wrap" Foreground="#64748B"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Powiadomienia e-mail" Style="{StaticResource Subheading}"/><TextBlock Text="Po zakończeniu cyklu program automatycznie wyśle wiadomość z wynikiem i artykułami. Uzupełnij SMTP i odbiorcę, a następnie wyślij wiadomość testową." TextWrapping="Wrap" Margin="0,0,0,12"/><UniformGrid Columns="3"><StackPanel Margin="0,0,14,0"><TextBlock Text="Serwer SMTP"/><TextBox Text="{Binding Settings.SmtpHost}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Port"/><TextBox Text="{Binding Settings.SmtpPort}"/></StackPanel><StackPanel><TextBlock Text="Zabezpieczenie połączenia"/><ComboBox ItemsSource="{Binding SmtpModes}" SelectedItem="{Binding Settings.SmtpSecurity}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Login"/><TextBox Text="{Binding Settings.SmtpUser}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Hasło / hasło aplikacji"/><PasswordBox x:Name="SmtpPasswordBox" PasswordChanged="SmtpPasswordChanged"/></StackPanel><StackPanel><TextBlock Text="Adres nadawcy"/><TextBox Text="{Binding Settings.MailFrom}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Adres odbiorcy"/><TextBox Text="{Binding Settings.MailTo}"/></StackPanel></UniformGrid><CheckBox Content="Dołącz ZIP z gotowymi tekstami PL/EN" IsChecked="{Binding Settings.AttachZip}" Margin="0,6,0,16"/><Button Content="Wyślij wiadomość testową" Command="{Binding TestMailCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pliki i dane aplikacji" Style="{StaticResource Subheading}"/><CheckBox Content="Eksportuj również zdjęcia z potwierdzonym prawem użycia (opcjonalnie)" IsChecked="{Binding Settings.ExportImages}" Margin="0,0,0,12"/><TextBlock Text="Folder eksportu"/><TextBox Text="{Binding Settings.ExportFolder}"/><WrapPanel><Button Content="Wybierz folder" Command="{Binding ChooseFolderCommand}"/><Button Content="Otwórz dane aplikacji" Command="{Binding OpenDataFolderCommand}"/></WrapPanel><TextBlock Text="{Binding DataFolder}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="Baza i zaszyfrowane sekrety pozostają w AppData. Kopia zapasowa musi obejmować całą bazę; sekrety DPAPI wymagają tego samego konta Windows." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12"/></StackPanel></Border>
     <Button Content="Zapisz ustawienia" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer></TabItem>
