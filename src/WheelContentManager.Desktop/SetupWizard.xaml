<Window x:Class="WheelContentManager.Desktop.SetupWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pierwsze uruchomienie — Wheel Content Manager" Width="750" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="620">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Zaczynamy od konfiguracji" Style="{StaticResource Heading}"/><TextBlock x:Name="StepLabel" Text="Krok 1 z 4" Foreground="#64748B" Margin="0,0,0,24"/></StackPanel>
 <TabControl x:Name="Steps" Grid.Row="1" BorderThickness="0" Background="Transparent"><TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Height" Value="0"/><Setter Property="Width" Value="0"/></Style></TabControl.ItemContainerStyle>
  <TabItem><ScrollViewer><StackPanel><TextBlock Text="1. Dostęp do AI" Style="{StaticResource Subheading}"/><TextBlock Text="API jest płatne osobno od abonamentu ChatGPT lub Claude. Klucz jest szyfrowany na Twoim koncie Windows." TextWrapping="Wrap" Margin="0,0,0,20"/><TextBlock Text="Dostawca"/><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Settings.AiProvider}"/><TextBlock Text="Klucz API (puste pole zachowuje zapisany klucz)"/><PasswordBox PasswordChanged="ApiKeyChanged"/><Button Content="Sprawdź klucz i pobierz modele" Command="{Binding LoadModelsCommand}"/><TextBlock Text="Model obsługujący obrazy"/><ComboBox ItemsSource="{Binding Models}" Text="{Binding Settings.AiModel}" IsEditable="True"/><UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="Cena input / milion tokenów (USD)"/><TextBox Text="{Binding Settings.InputPricePerMillion}"/></StackPanel><StackPanel><TextBlock Text="Cena output / milion tokenów (USD)"/><TextBox Text="{Binding Settings.OutputPricePerMillion}"/></StackPanel></UniformGrid><TextBlock Text="Ceny wpisz zgodnie z aktualnym cennikiem wybranego modelu. Domyślny limit kosztu cyklu to 10 USD." TextWrapping="Wrap" Foreground="#64748B"/></StackPanel></ScrollViewer></TabItem>
  <TabItem><ScrollViewer><StackPanel><TextBlock Text="2. Powiadomienia e-mail" Style="{StaticResource Subheading}"/><TextBlock Text="Program wyśle zbiorczy raport cyklu. Klucze i hasła wpisuj tutaj, nigdy w czacie ani w plikach projektu." TextWrapping="Wrap" Margin="0,0,0,16"/><TextBlock Text="Serwer SMTP"/><TextBox Text="{Binding Settings.SmtpHost}"/><UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="Port"/><TextBox Text="{Binding Settings.SmtpPort}"/></StackPanel><StackPanel><TextBlock Text="TLS"/><ComboBox ItemsSource="{Binding SmtpModes}" SelectedItem="{Binding Settings.SmtpSecurity}"/></StackPanel></UniformGrid><TextBlock Text="Login"/><TextBox Text="{Binding Settings.SmtpUser}"/><TextBlock Text="Hasło / hasło aplikacji"/><PasswordBox PasswordChanged="SmtpPasswordChanged"/><TextBlock Text="Adres nadawcy"/><TextBox Text="{Binding Settings.MailFrom}"/><TextBlock Text="Adres odbiorcy"/><TextBox Text="{Binding Settings.MailTo}"/><Button Content="Wyślij wiadomość testową" Command="{Binding TestMailCommand}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem><ScrollViewer><StackPanel><TextBlock Text="3. Pliki i termin pracy" Style="{StaticResource Subheading}"/><TextBlock Text="Folder artykułów"/><TextBox Text="{Binding Settings.ExportFolder}"/><Button Content="Wybierz folder" Command="{Binding ChooseFolderCommand}"/><TextBlock Text="Domyślnie: poniedziałek o 08:00, jeden artykuł na markę. Harmonogram włącz dopiero po udanym teście jednej galerii i pełnego cyklu." TextWrapping="Wrap" Margin="0,24"/><CheckBox Content="Chcę włączyć automatyzację po zakończeniu konfiguracji" IsChecked="{Binding Settings.ScheduleEnabled}"/><TextBlock Text="Zadanie rejestruje się osobno w zakładce Harmonogram. Komputer musi być włączony, a konto zalogowane; okno programu może być zamknięte." TextWrapping="Wrap" Foreground="#64748B" Margin="0,20"/></StackPanel></ScrollViewer></TabItem>
  <TabItem><ScrollViewer><StackPanel><TextBlock Text="4. Instrukcje redakcyjne" Style="{StaticResource Subheading}"/><TextBlock Text="Zaimportuj Wpisy na bloga.docx. Program zachowa pełne sekcje JR, CVR i VSR. Następnie w Prompty AI zastąp konkretne przykłady dynamicznymi zmiennymi i potwierdź każdy szablon." TextWrapping="Wrap" Margin="0,0,0,20"/><Button Content="Importuj dokument redakcyjny" Command="{Binding ImportPromptCommand}"/><TextBlock Text="Po zapisaniu ustawień:" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock Text="• Otwórz Prompty AI i sprawdź trzy szablony.&#10;• Kliknij Sprawdź galerie.&#10;• Wybierz prawdziwy samochód i wykonaj test AI.&#10;• Sprawdź teksty, a następnie wygeneruj pełny cykl.&#10;• W Harmonogramie zastosuj ustawienia Windows." TextWrapping="Wrap" LineHeight="26"/><TextBlock Text="Artykuły nie są automatycznie publikowane." FontWeight="SemiBold" Margin="0,20"/></StackPanel></ScrollViewer></TabItem>
 </TabControl>
 <DockPanel Grid.Row="2" Margin="0,24,0,0"><Button Content="Dokończę później" Click="Later" Background="#64748B" DockPanel.Dock="Left"/><Button x:Name="NextButton" Content="Dalej" Click="Next" DockPanel.Dock="Right"/><Button x:Name="BackButton" Content="Wstecz" Click="Back" DockPanel.Dock="Right" Background="#64748B" IsEnabled="False"/></DockPanel>
 </Grid>
</Window>
